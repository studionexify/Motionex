{
  "name": "motionex",
  "productName": "Motionex",
  "version": "0.1.0",
  "description": "Motionex \u2014 motion G-code generator and slicer",
  "main": "electron/dist/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p electron/tsconfig.json && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:dev": "node scripts/build-electron.mjs && concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && cross-env NEXSPIRO_DEV_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win --publish never && node scripts/package-win.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "hanex:prints": "cross-env HANEX_TEST_PRINTS=out/hanex vitest run tests/hanex/calibration.test.ts",
    "desktop:win": "npm version patch --no-git-tag-version && npm run build && electron-builder --win nsis --x64",
    "build:bridge": "esbuild bridge/main.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist-bridge/motionex-bridge.cjs",
    "build:web": "npm run build:bridge && vite build -c vite.web.config.ts && cp dist-bridge/motionex-bridge.cjs dist-web/motionex-bridge.cjs",
    "dev:web": "vite -c vite.web.config.ts",
    "bridge": "npm run build:bridge && node dist-bridge/motionex-bridge.cjs"
  },
  "build": {
    "appId": "com.motionex.app",
    "productName": "Motionex",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/dist/**",
      "electron/preload.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Motionex-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Motionex",
      "uninstallDisplayName": "Motionex",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "maintainer": "Motionex"
    },
    "asar": true,
    "publish": null
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.12",
    "aedes": "^0.51.3",
    "basic-ftp": "^5.3.1",
    "clipper-lib": "^6.4.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.21.5",
    "ftp-srv": "^4.6.3",
    "jszip": "^3.10.1",
    "mqtt": "^5.16.1",
    "occt-import-js": "^0.0.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "three-bvh-csg": "^0.0.17",
    "three-gpu-pathtracer": "^0.0.23",
    "three-mesh-bvh": "^0.9.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1",
    "zustand": "^4.5.5"
  },
  "author": "Motionex",
  "license": "UNLICENSED",
  "homepage": "https://github.com/studionexify/Motionex",
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "bwip-js": "^4.11.4",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^1.3.4"
  }
}
